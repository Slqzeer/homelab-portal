---
import CatalogCard from '../components/CatalogCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import StaleBanner from '../components/StaleBanner.astro';
import { devCatalogueItems } from '../data/dev-fixtures';
import '../styles/app.css';

const items = import.meta.env.DEV ? devCatalogueItems : [];
const categories = [...new Set(items.map((item) => item.category))].sort();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Trusted links to intentionally published homelab services." />
    <title>Homelab Portal</title>
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header catalog-header">
      <p class="eyebrow catalog-header-label">Homelab Portal</p>
      <nav class="identity-actions" aria-label="Account">
        <button class="button button-secondary" type="button" data-theme-toggle>Switch to light theme</button>
        {import.meta.env.DEV && <a class="button button-secondary" href="/admin">Admin diagnostics</a>}
      </nav>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <div class="catalog-shell">
        <aside class="catalog-information-rail" aria-labelledby="portal-title">
          
          <p class="eyebrow">Available to you</p>
          <h2>Service catalogue</h2>
          <p>Open an intentionally published service. Each target application manages its own access.</p>
          <p class="catalog-status" data-catalog-status role="status" aria-live="polite" aria-atomic="true">
            {items.length} catalog {items.length === 1 ? 'item' : 'items'}
          </p>
          <StaleBanner stale={import.meta.env.DEV} />
        </aside>
        <div class="catalog-main">
          <CategoryFilter categories={categories} />
          <section aria-labelledby="catalog-results-heading">
            <h3 id="catalog-results-heading" class="visually-hidden">Catalog items</h3>
            <section class="empty-filter-results" data-empty-results hidden aria-labelledby="empty-filter-results-heading">
              <h3 id="empty-filter-results-heading">No catalog items match these filters.</h3>
              <p>Clear a filter to see available catalog items.</p>
              <div class="empty-filter-actions">
                <button type="button" data-empty-clear-search>Clear search</button>
                <button type="button" data-empty-clear-category>Return to All</button>
              </div>
            </section>
            <div id="catalog-items" class="catalog-grid" data-catalog-grid>
              {items.map((item) => <CatalogCard {...item} />)}
              {items.length === 0 && <p class="empty-catalog">No catalog items are available.</p>}
            </div>
          </section>
        </div>
      </div>
    </main>
    <script is:inline src="/app.js" defer></script>
  </body>
</html>
